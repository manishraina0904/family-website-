# Builder.io Public Key (required for Builder.io CMS integration)
# Replace __BUILDER_PUBLIC_KEY__ with your actual Builder.io public API key
VITE_PUBLIC_BUILDER_KEY=__BUILDER_PUBLIC_KEY__

# Used by the demo API route (/api/demo)
PING_MESSAGE="ping pong"

# ==========================
# Email (Contact Form) Setup
# ==========================
